{"duration": 63.68, "segments": [{"scene": "hook", "text": "Don Fredy construyó una rampa de cemento en la acera, para subir su carro a la cochera.", "pause": 0.2, "start": 0.3, "end": 5.18, "words": [{"w": "Don", "s": 0.3, "e": 0.5}, {"w": "Freddy", "s": 0.5, "e": 0.84}, {"w": "construyó", "s": 0.84, "e": 1.5}, {"w": "una", "s": 1.5, "e": 1.64}, {"w": "rampa", "s": 1.64, "e": 2.04}, {"w": "de", "s": 2.04, "e": 2.12}, {"w": "cemento", "s": 2.12, "e": 2.6}, {"w": "en", "s": 2.6, "e": 2.66}, {"w": "la", "s": 2.66, "e": 2.78}, {"w": "acera", "s": 2.78, "e": 3.14}, {"w": "para", "s": 3.14, "e": 3.6}, {"w": "subir", "s": 3.6, "e": 3.86}, {"w": "su", "s": 3.86, "e": 4.14}, {"w": "carro", "s": 4.14, "e": 4.38}, {"w": "a", "s": 4.38, "e": 4.5}, {"w": "la", "s": 4.5, "e": 4.58}, {"w": "cochera.", "s": 4.58, "e": 5.02}]}, {"scene": "calle", "text": "Ahora doña Carmen tiene que bajar a la calle con el coche de su bebé, entre los carros.", "pause": 0.25, "start": 5.38, "end": 10.08, "words": [{"w": "Ahora", "s": 5.38, "e": 5.64}, {"w": "Doña", "s": 5.64, "e": 5.98}, {"w": "Carmen", "s": 5.98, "e": 6.32}, {"w": "tiene", "s": 6.32, "e": 6.76}, {"w": "que", "s": 6.76, "e": 6.94}, {"w": "bajar", "s": 6.94, "e": 7.28}, {"w": "a", "s": 7.28, "e": 7.32}, {"w": "la", "s": 7.32, "e": 7.42}, {"w": "calle", "s": 7.42, "e": 7.76}, {"w": "con", "s": 7.76, "e": 7.98}, {"w": "el", "s": 7.98, "e": 8.1}, {"w": "coche", "s": 8.1, "e": 8.42}, {"w": "de", "s": 8.42, "e": 8.5}, {"w": "su", "s": 8.5, "e": 8.64}, {"w": "bebé", "s": 8.64, "e": 9.0}, {"w": "entre", "s": 9.0, "e": 9.24}, {"w": "los", "s": 9.24, "e": 9.42}, {"w": "carros.", "s": 9.42, "e": 9.82}]}, {"scene": "pleito", "who": "carmen", "voice": "ef_dora", "text": "¡Usted se adueñó de la acera! Me tengo que tirar a la calle con mi niño.", "pause": 0.2, "start": 10.33, "end": 14.52, "words": [{"w": "Si", "s": 10.33, "e": 10.55}, {"w": "usted", "s": 10.55, "e": 10.71}, {"w": "se", "s": 10.71, "e": 10.95}, {"w": "adueñó", "s": 10.95, "e": 11.