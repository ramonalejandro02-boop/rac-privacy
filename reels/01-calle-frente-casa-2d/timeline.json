{"duration": 66.0, "segments": [{"scene": "hook", "text": "¿Le han parqueado frente a su casa… y sintió que le robaron algo?", "pause": 0.35, "start": 0.4, "end": 3.3, "words": [{"w": "Le", "s": 0.4, "e": 0.6}, {"w": "han", "s": 0.6, "e": 0.7}, {"w": "parqueado", "s": 0.7, "e": 1.02}, {"w": "frente", "s": 1.02, "e": 1.16}, {"w": "a", "s": 1.16, "e": 1.32}, {"w": "su", "s": 1.32, "e": 1.4}, {"w": "casa", "s": 1.4, "e": 1.62}, {"w": "y", "s": 1.62, "e": 1.94}, {"w": "sin", "s": 1.94, "e": 2.08}, {"w": "ti", "s": 2.08, "e": 2.2}, {"w": "que", "s": 2.2, "e": 2.28}, {"w": "le", "s": 2.28, "e": 2.38}, {"w": "robaron", "s": 2.38, "e": 2.74}, {"w": "algo.", "s": 2.74, "e": 2.92}]}, {"scene": "marta", "text": "Ella es doña Marta. Todas las mañanas limpia su frente.", "pause": 0.25, "seed": 77, "start": 3.65, "end": 6.65, "words": [{"w": "Ella", "s": 3.65, "e": 3.91}, {"w": "es", "s": 3.91, "e": 4.07}, {"w": "Doña", "s": 4.07, "e": 4.27}, {"w": "Marta.", "s": 4.27, "e": 4.65}, {"w": "Todas", "s": 4.87, "e": 5.07}, {"w": "las", "s": 5.07, "e": 5.17}, {"w": "mañanas", "s": 5.17, "e": 5.59}, {"w": "limpia", "s": 5.59, "e": 5.93}, {"w": "su", "s": 5.93, "e": 6.03}, {"w": "frente.", "s": 6.03, "e": 6.25}]}, {"scene": "llega", "text": "Pero hoy, don Carlos parqueó su carro justo ahí.", "pause": 0.25, "start": 6.9, "end": 10.7, "words": [{"w": "Pero", "s": 6.9, "e": 7.08}, {"w": "hoy,", "s": 7.08, "e": 7.3}, {"w": "Don", "s": 7.56, "e": 7.64}, {"w": "Carlos", "s": 7.64, "e": 7.92}, {"w": "parqueó", "s": 7.92, "e": 8.28}, {"w": "su", "s": 8.28, "e": 8.4}, {"w": "carro", "s": 8.4, "e": 8.62}, {"w": "justo", "s": 8.62, "e": 8.96}, {"w": "ahí.", "s": 8.96, "e": 9.22}]}, {"scene": "reclamo", "text": "Y doña Marta le reclamó:", "pause": 0.15, "start": 10.95, "end": 12.49, "words": [{"w": "y", "s": 10.95, "e": 11.13}, {"w": "doña", "s": 11.13, "e": 11.35}, {"w": "Marta", "s": 11.35, "e": 11.69}, {"w": "le", "s": 11.69, "e": 11.75}, {"w": "reclamó.", "s": 11.75, "e": 12.23}]}, {"scene": "re