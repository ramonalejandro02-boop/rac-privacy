{"duration": 59.27, "segments": [{"scene": "hook", "text": "Todos los días, el perro del vecino hace sus necesidades frente a la casa de doña Tere.", "pause": 0.2, "start": 0.3, "end": 5.44, "words": [{"w": "Todos", "s": 0.3, "e": 0.5}, {"w": "los", "s": 0.5, "e": 0.76}, {"w": "días,", "s": 0.76, "e": 1.06}, {"w": "el", "s": 1.44, "e": 1.56}, {"w": "perro", "s": 1.56, "e": 1.86}, {"w": "del", "s": 1.86, "e": 1.94}, {"w": "vecino", "s": 1.94, "e": 2.44}, {"w": "hace", "s": 2.44, "e": 2.72}, {"w": "sus", "s": 2.72, "e": 2.94}, {"w": "necesidades", "s": 2.94, "e": 3.6}, {"w": "frente", "s": 3.6, "e": 3.96}, {"w": "a", "s": 3.96, "e": 4.24}, {"w": "la", "s": 4.24, "e": 4.32}, {"w": "casa", "s": 4.32, "e": 4.58}, {"w": "de", "s": 4.58, "e": 4.76}, {"w": "Doña", "s": 4.76, "e": 4.96}, {"w": "Tere.", "s": 4.96, "e": 5.28}]}, {"scene": "cansada", "text": "Y ella ya se cansó.", "pause": 0.2, "start": 5.64, "end": 7.24, "words": [{"w": "y", "s": 5.64, "e": 5.82}, {"w": "ella", "s": 5.82, "e": 6.1}, {"w": "ya", "s": 6.1, "e": 6.3}, {"w": "se", "s": 6.3, "e": 6.48}, {"w": "canso.", "s": 6.48, "e": 6.94}]}, {"scene": "pleito", "who": "tere", "voice": "ef_dora", "text": "¡Recoja lo de su perro, o se lo tiro en su portón!", "pause": 0.2, "start": 7.44, "end": 10.33, "words": [{"w": "Precoja", "s": 7.44, "e": 7.9}, {"w": "lo", "s": 7.9, "e": 8.0}, {"w": "de", "s": 8.0, "e": 8.14}, {"w": "su", "s": 8.14, "e": 8.24}, {"w": "perro", "s": 8.24, "e": 8.66}, {"w": "o", "s": 8.66, "e": 8.9}, {"w": "se", "s": 8.9, "e": 9.0}, {"w": "lo", "s": 9.0, "e": 9.1}, {"w": "tiro", "s": 9.1, "e": 9.36}, {"w": "en", "s": 9.36, "e": 9.5}, {"w": "su", "s": 9.5, "e": 9.64}, {"w": "portón.", "s": 9.64, "e": 10.08}]}, {"scene": "pleito", "who": "beto", "voice": "em_santa", "text": "Mi perro es libre. La calle es de todos.", "pause": 0.3, "start": 10.53, "end": 13.05, "words": [{"w": "Mi", "s": 10.53, "e": 10.71}, {"w": "perro", "s": 10.71, "e": 11.05}, {"w": "es", "s": 11.05, "e": 11.17}, {"w": "libre,", "