5.62, "e": 25.88}]}, {"scene": "saber", "text": "Trabajar en casa es válido. Pero la calle y la acera no son bodega ni taller: deben quedar libres y seguras. Y el aceite derramado contamina.", "pause": 0.3, "start": 26.49, "end": 34.76, "words": [{"w": "Trabajar", "s": 26.49, "e": 27.01}, {"w": "en", "s": 27.01, "e": 27.11}, {"w": "casa", "s": 27.11, "e": 27.35}, {"w": "es", "s": 27.35, "e": 27.59}, {"w": "válido,", "s": 27.59, "e": 28.07}, {"w": "pero", "s": 28.19, "e": 28.41}, {"w": "la", "s": 28.41, "e": 28.57}, {"w": "calle", "s": 28.57, "e": 28.87}, {"w": "y", "s": 28.87, "e": 29.05}, {"w": "la", "s": 29.05, "e": 29.13}, {"w": "acera", "s": 29.13, "e": 29.43}, {"w": "no", "s": 29.43, "e": 29.63}, {"w": "son", "s": 29.63, "e": 29.85}, {"w": "bodega", "s": 29.85, "e": 30.19}, {"w": "ni", "s": 30.19, "e": 30.37}, {"w": "taller,", "s": 30.37, "e": 30.61}, {"w": "deben", "s": 30.93, "e": 31.17}, {"w": "quedar", "s": 31.17, "e": 31.43}, {"w": "libres", "s": 31.43, "e": 31.95}, {"w": "y", "s": 31.95, "e": 32.07}, {"w": "seguras", "s": 32.07, "e": 32.55}, {"w": "y", "s": 32.55, "e": 32.99}, {"w": "el", "s": 32.99, "e": 33.09}, {"w": "aceite", "s": 33.09, "e": 33.39}, {"w": "de", "s": 33.39, "e": 33.61}, {"w": "ramado", "s": 33.61, "e": 33.99}, {"w": "contamina.", "s": 33.99, "e": 34.61}]}, {"scene": "mito", "text": "Pero ponchar llantas, o humillarlo frente a todos, solo calienta el pleito.", "pause": 0.3, "start": 35.06, "end": 39.18, "words": [{"w": "pero", "s": 35.06, "e": 35.26}, {"w": "ponchar", "s": 35.26, "e": 35.64}, {"w": "llantas", "s": 35.64, "e": 36.14}, {"w": "o", "s": 36.14, "e": 36.46}, {"w": "humillarlo", "s": 36.46, "e": 36.96}, {"w": "frente", "s": 36.96, "e": 37.16}, {"w": "a", "s": 37.16, "e": 37.4}, {"w": "todos", "s": 37.4, "e": 37.7}, {"w": "solo", "s": 37.7, "e": 38.06}, {"w": "calienta", "s": 38.06, "e": 38.62}, {"w": "el", "s": 38.62, "e": 38.7}, {"w": "pleito.", "s": 38.7, "e": 39.1}]}, {"scene": "pasos", "text": "Lo que funciona: primero, conversar y acordar horarios y espacios de trabajo.", "pause": 0.2, "start": 39.48, "end": 43.99, "words": [{"w": "Lo", "s": 39.48, "e": 39.64}, {"w": "que", "s": 39.64, "e": 39.78}, {"w": "funciona,", "s": 39.78, "e": 40.24}, {"w": "primero", "s": 40.58, "e": 40.94}, {"w": "conversar", "s": 40.94, "e": 41.8}, {"w": "y", "s": 41.8, "e": 41.9}, {"w": "acordar", "s": 41.9, "e": 42.32}, {"w": "horarios", "s": 42.32, "e": 42.76}, {"w": "y", "s": 42.76, "e": 42.94}, {"w": "espacios", "s": 42.94, "e": 43.4}, {"w": "de", "s": 43.4, "e": 43.48}, {"w": "trabajo.", "s": 43.48, "e": 43.74}]}, {"scene": "pasos", "text": "Segundo, llevar el tema al patronato, para reglas claras en toda la calle.", "pause": 0.2, "start": 44.19, "end": 48.46, "words": [{"w": "Segundo,", "s": 44.19, "e": 44.71}, {"w": "llevar", "s": 44.89, "e": 45.03}, {"w": "el", "s": 45.03, "e": 45.25}, {"w": "tema", "s": 45.25, "e": 45.49}, {"w": "al", "s": 45.49, "e": 45.63}, {"w": "patronato", "s": 45.63, "e": 46.23}, {"w": "para", "s": 46.23, "e": 46.57}, {"w": "reglas", "s": 46.57, "e": 46.95}, {"w": "claras", "s": 46.95, "e": 47.43}, {"w": "en", "s": 47.43, "e": 47.57}, {"w": "toda", "s": 47.57, "e": 47.75}, {"w": "la", "s": 47.75, "e": 47.93}, {"w": "calle.", "s": 47.93, "e": 48.25}]}, {"scene": "pasos", "text": "Y tercero, buscar orientación en CONAFEPH antes de que el conflicto crezca.", "say": "Y tercero, buscar orientación en Conafép antes de que el conflicto crezca.", "pause": 0.3, "start": 48.66, "end": 53.05, "words": [{"w": "y,", "s": 48.66, "e": 48.84}, {"w": "tercero,", "s": 48.88, "e": 49.32}, {"w": "buscar", "s": 49.48, "e": 49.7}, {"w": "orientación", "s": 49.7, "e": 50.44}, {"w": "en", "s": 50.44, "e": 50.6}, {"w": "Conafep", "s": 50.6, "e": 51.08}, {"w": "antes", "s": 51.08, "e": 51.48}, {"w": "de", "s": 51.48, "e": 51.68}, {"w": "que", "s": 51.68, "e": 51.76}, {"w": "el", "s": 51.76, "e": 51.86}, {"w": "conflicto", "s": 51.86, "e": 52.42}, {"w": "crezca.", "s": 52.42, "e": 52.84}]}, {"scene":